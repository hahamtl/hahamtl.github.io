---
import '../styles/global.css';
const { title = 'Lin Zhu', description = 'Notes from an engineer on tooling, automation and AI agents in production.', path = '/' } = Astro.props;
const site = 'Lin Zhu';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title === site ? site : `${title} · ${site}`}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="article" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="alternate" type="application/rss+xml" title={site} href="/rss.xml" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <slot name="head" />
</head>
<body>
  <div class="wrap">
    <header class="site">
      <a class="brand" href="/">Lin Zhu<small>staff engineer · tooling &amp; AI enablement</small></a>
      <nav>
        <a href="/" aria-current={path === '/' ? 'page' : undefined}>Writing</a>
        <a href="/about" aria-current={path === '/about' ? 'page' : undefined}>About</a>
        <a href="/rss.xml">RSS</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site">
      <span>© {new Date().getFullYear()} Lin Zhu · opinions my own</span>
      <span>Markdown in git · built with Astro · hosted anywhere</span>
    </footer>
  </div>
</body>
</html>
