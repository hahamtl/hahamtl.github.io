---
import '../styles/global.css';
import { t, prefix, type Lang } from '../i18n';
interface Props { lang?: Lang; title?: string; description?: string; path?: string; alt?: string | null; }
const { lang = 'en', title, description, path = '/', alt = null } = Astro.props as Props;
const site = t(lang, 'siteName');
const pageTitle = !title || title === site ? site : `${title} · ${site}`;
const desc = description ?? t(lang, 'description');
const p = prefix(lang);
const home = `${p}/`;
const about = `${p}/about/`;
const rss = `${p}/rss.xml`;
const otherLang: Lang = lang === 'en' ? 'zh' : 'en';
// Language switch target: the translated page when it exists, else the other language's home.
const switchHref = alt ?? `${prefix(otherLang)}/`;
const isHome = path === home || path === p || path === '/';
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={desc} />
  <meta property="og:title" content={title ?? site} />
  <meta property="og:description" content={desc} />
  <meta property="og:type" content="article" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="alternate" type="application/rss+xml" title={site} href={rss} />
  {alt && <link rel="alternate" hreflang={otherLang === 'zh' ? 'zh-CN' : 'en'} href={new URL(alt, Astro.site)} />}
  {alt && <link rel="alternate" hreflang={lang === 'zh' ? 'zh-CN' : 'en'} href={new URL(path, Astro.site)} />}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <slot name="head" />
</head>
<body>
  <div class="wrap">
    <header class="site">
      <a class="brand" href={home}>{site}<small>{t(lang, 'tagline')}</small></a>
      <nav>
        <a href={home} aria-current={isHome ? 'page' : undefined}>{t(lang, 'nav_writing')}</a>
        <a href={about} aria-current={path === about ? 'page' : undefined}>{t(lang, 'nav_about')}</a>
        <a href={rss}>{t(lang, 'nav_rss')}</a>
        <a class="lang" href={switchHref} lang={otherLang === 'zh' ? 'zh-CN' : 'en'} title={alt ? t(lang, 'read_in_other') : undefined}>{t(lang, 'switch')}</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site">
      <span>© {new Date().getFullYear()} Lin Zhu · {t(lang, 'footer_left')}</span>
      <span>{t(lang, 'footer_right')}</span>
    </footer>
  </div>
</body>
</html>
