---
// One post page, any language.
import Base from '../layouts/Base.astro';
import { render } from 'astro:content';
import { fmtDate, postUrl, topicUrl, topicName, splitId, t, type Lang } from '../i18n';
import { translationOf, postsIn, byOrder } from '../lib/posts';
interface Props { post: any; }
const { post } = Astro.props as Props;
const { lang, slug } = splitId(post.id) as { lang: Lang; slug: string };
const { Content } = await render(post);
const other = await translationOf(slug, lang);
const alt = other ? postUrl(other, slug) : null;
const ordered = byOrder((await postsIn(lang)).filter(p => p.data.order != null));
const idx = ordered.findIndex(p => p.id === post.id);
const prev = idx > 0 ? ordered[idx - 1] : null;
const next = idx >= 0 && idx < ordered.length - 1 ? ordered[idx + 1] : null;
const num = (p: any) => String(p.data.order).padStart(2, '0');
---
<Base lang={lang} title={post.data.title} description={post.data.description} path={postUrl(lang, slug)} alt={alt}>
  <Fragment slot="head">{post.data.cover && <meta property="og:image" content={new URL(post.data.cover, Astro.site)} />}</Fragment>
  <article>
    <h1>{post.data.title}</h1>
    <div class="meta">
      {fmtDate(post.data.date, lang, true)}
      {post.data.tags.map(tg => <a class="tag" href={topicUrl(lang, tg)}>{topicName(tg, lang)}</a>)}
    </div>
    {alt && <a class="langbar" href={alt} lang={other === 'zh' ? 'zh-CN' : 'en'}>{t(lang, 'read_in_other')}</a>}
    <Content />
  </article>
  {(prev || next) && <nav class="pn">
    {prev ? <a class="prev" href={postUrl(lang, splitId(prev.id).slug)}><small>{t(lang, 'prev_post')}</small>{prev.data.title}</a> : <span></span>}
    {next ? <a class="next" href={postUrl(lang, splitId(next.id).slug)}><small>{t(lang, 'next_post')}</small>{next.data.title}</a> : <span></span>}
  </nav>}
  <script>
    // Give every body cell the header text so phone-width tables can stack into cards.
    document.querySelectorAll('article table').forEach(t => {
      const heads = [...t.querySelectorAll('thead th')].map(th => th.textContent.trim());
      t.querySelectorAll('tbody tr').forEach(tr => [...tr.children].forEach((td, i) => { if (heads[i]) td.setAttribute('data-label', heads[i]); }));
    });
  </script>
</Base>
