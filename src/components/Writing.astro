---
// The "Writing" page body, shared by / and /zh/ and by topic pages.
import PostList from './PostList.astro';
import TopicChips from './TopicChips.astro';
import { t, topicName, type Lang } from '../i18n';
import { postsIn, topicsUsed } from '../lib/posts';
interface Props { lang: Lang; topic?: string | null; }
const { lang, topic = null } = Astro.props as Props;
const all = await postsIn(lang);
const topics = topicsUsed(all);
const posts = topic ? all.filter(p => p.data.tags.includes(topic)) : all;
---
<h1>{topic ? topicName(topic, lang) : t(lang, 'writing_h1')}</h1>
{!topic && <p class="lede">{t(lang, 'writing_lede')}</p>}
<TopicChips lang={lang} topics={topics} current={topic} />
<PostList lang={lang} posts={posts} />
