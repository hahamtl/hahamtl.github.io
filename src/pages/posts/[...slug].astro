---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(p => ({ params: { slug: p.id }, props: { post: p } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const fmt = d => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={post.data.title} description={post.data.description} path={`/posts/${post.id}/`}>
  <Fragment slot="head">{post.data.cover && <meta property="og:image" content={new URL(post.data.cover, Astro.site)} />}</Fragment>
  <article>
    <h1>{post.data.title}</h1>
    <div class="meta">{fmt(post.data.date)}{post.data.tags.map(t => <span class="tag">{t}</span>)}</div>
    <Content />
  </article>
</Base>
